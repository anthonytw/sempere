<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The watch app (docs/design/1.1-watch.md): the App Group holds only the quick voice note status its widgets show (VoiceNoteStatusStore): no key, no note. The group id is the iOS targets' too; the container is the watch's own. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.io.github.anthonytw.sempere</string>
	</array>
</dict>
</plist>
