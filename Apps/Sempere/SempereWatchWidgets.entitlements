<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The watch widgets read the quick voice note status the watch app writes into its App Group (VoiceNoteStatusStore): no key, no note. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.io.github.anthonytw.sempere</string>
	</array>
</dict>
</plist>
