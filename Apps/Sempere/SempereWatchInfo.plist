<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (INFOPLIST_KEY_* build settings). -->
	<key>WKApplication</key>
	<true/>
	<!-- Paired with the iPhone app, which provisions it. -->
	<key>WKCompanionAppBundleIdentifier</key>
	<string>io.github.anthonytw.sempere</string>
	<!-- Not independent of the iPhone app (design 1.1-watch.md, section 1 non-goals): the profile comes from it. The watch still
	     records and seals without the phone near; the notes wait in its outbox. -->
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<false/>
	<!-- A voice note keeps recording with the wrist down and the screen off (docs/design/1.1-watch.md §3.5; real-watch check W1). Review note: the app records only after a tap on Record, a complication, a widget, the Control, the Action button or Siri, and the system shows its recording indicator. On watchOS the audio mode is a UIBackgroundModes value: WKBackgroundModes takes only the watch's own session modes (workout, self care, …), and App Store Connect refuses `audio` there. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
