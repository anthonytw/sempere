<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Tests and screenshots only, never shipped: Sempere.entitlements WITHOUT the iCloud and push entitlements. They are restricted:
	     an ad-hoc signature cannot carry them (Xcode: "entitlements that require signing with a development certificate"), so
	     `scripts/app.sh` signs every ad-hoc Mac Catalyst run (test-mac, the UI and smoke tests, screenshots) with this file; the
	     app then runs with no CloudKit (`CloudKitDatabase.availability()` is false) and says so where a CloudKit target is used.
	     Keep the other keys equal to Sempere.entitlements (`scripts/test-release-check.sh` fails when they differ). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.print</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
