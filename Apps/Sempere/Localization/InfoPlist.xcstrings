{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "comment" : "Camera permission prompt. Key is the Info.plist key.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempere uses the camera to add photos to your notes and to scan another device's join code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempere usa la cámara para añadir fotos a tus notas y para escanear el código de unión de otro dispositivo."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempere uses Face ID to unlock a vault that asks for it on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempere usa Face ID para desbloquear una bóveda que lo pide en este dispositivo."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempere uses the microphone to record audio into your notes. Recordings are encrypted in your vault."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempere usa el micrófono para grabar audio en tus notas. Las grabaciones se cifran en tu bóveda."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempere transcribes your recordings on this device. Audio is never sent to a server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempere transcribe tus grabaciones en este dispositivo. El audio nunca se envía a un servidor."
          }
        }
      }
    },
    "Sempere Notebook (drag inside the app)" : {
      "comment" : "UTTypeDescription of the in-app drag type for a notebook.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuaderno de Sempere (arrastrar dentro de la app)"
          }
        }
      }
    },
    "Sempere Notes (drag inside the app)" : {
      "comment" : "UTTypeDescription of the in-app drag type for notes.",
      "extractionState" : "manual",
      "localizations" : {
