{
  "sourceLanguage" : "en",
  "strings" : {
    "%@\nUse the passphrase or paste the key instead." : {
      "comment" : "%@ is why the saved key could not be used",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nUsa la frase de contraseña o pega la clave."
          }
        }
      }
    },
    "%@ (Restored)" : {
      "comment" : "Restore from Backup: suggested name of the new vault; %@ is the backed-up vault's name",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (restaurada)"
          }
        }
      }
    },
    "%@ A password manager that takes files or text (for example from the share sheet) is the best place. The same file from a terminal: sempere keys generate / sempere keys export." : {
      "comment" : "Footer under Save to Files and Share of a key; %@ is the plain-text warning before it; commands are not translated",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ El mejor lugar es un gestor de contraseñas que acepte archivos o texto (por ejemplo, desde el menú Compartir). El mismo archivo desde un terminal: sempere keys generate / sempere keys export."
          }
        }
      }
    },
    "%@ Import" : {
      "comment" : "Alert title after an import from another app (the app's name)",
