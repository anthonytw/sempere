    "%lld files could not be re-encrypted. If this vault is in iCloud Drive, wait until it has downloaded and try again; otherwise unlock it with the key it was encrypted to (the classic key while one is listed) and try again." : {
      "comment" : "Migration error",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld file could not be re-encrypted. If this vault is in iCloud Drive, wait until it has downloaded and try again; otherwise unlock it with the key it was encrypted to (the classic key while one is listed) and try again."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld files could not be re-encrypted. If this vault is in iCloud Drive, wait until it has downloaded and try again; otherwise unlock it with the key it was encrypted to (the classic key while one is listed) and try again."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld de archivos no se han podido volver a cifrar. Si esta bóveda está en iCloud Drive, espera a que se descargue y vuelve a intentarlo; si no, desbloquéala con la clave con la que estaba cifrada (la clásica mientras haya una) y vuelve a intentarlo."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld archivo no se ha podido volver a cifrar. Si esta bóveda está en iCloud Drive, espera a que se descargue y vuelve a intentarlo; si no, desbloquéala con la clave con la que estaba cifrada (la clásica mientras haya una) y vuelve a intentarlo."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld archivos no se han podido volver a cifrar. Si esta bóveda está en iCloud Drive, espera a que se descargue y vuelve a intentarlo; si no, desbloquéala con la clave con la que estaba cifrada (la clásica mientras haya una) y vuelve a intentarlo."
                }
              }
            }
          }
        }
      }
    },
