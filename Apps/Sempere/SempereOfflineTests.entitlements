<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Tests only, never shipped: Sempere.entitlements WITHOUT com.apple.security.network.client.
	     `scripts/app.sh test-mac-offline` signs the Catalyst test host with it, so the sandbox refuses
	     every outbound connection and the app suites run as on a device that is never online
	     (docs/ci.md "Offline mode"). OfflineModeTests fails when the mode is not in force.
	     Keep the other keys equal to Sempere.entitlements. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.print</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
