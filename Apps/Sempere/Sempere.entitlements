<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac Catalyst builds only (CODE_SIGN_ENTITLEMENTS[sdk=macosx*]); the iPad build has no entitlements file. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Vault folders picked in the open panel (read and write). -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Bookmarks of those folders, kept across launches (recent vaults). -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Printing the recovery kit (the sandbox refuses to print without it). -->
	<key>com.apple.security.print</key>
	<true/>
	<!-- Recording audio into notes (the sandbox blocks the microphone without it). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- WebDAV vaults: connections to the server the user configures (docs/io.md, "WebDAV vaults in the app"). -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Joining nearby: Add Device listens for the new device's connection (docs/design/nearby-join.md). -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- iCloud (CloudKit) sync targets (docs/design/1.4-cloudkit.md §6.4): the app's one container, the private database only. The
	     container environment is left to the signing (Xcode sets Production on export). -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.io.github.anthonytw.sempere</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Silent pushes when another device changes a vault's zone (hints only): `development` in Debug, `production` in Release
	     ($(APS_ENVIRONMENT), the project's build settings). On Mac Catalyst the key is this one, not aps-environment. -->
	<key>com.apple.developer.aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
</dict>
</plist>
