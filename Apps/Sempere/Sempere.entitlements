<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac Catalyst builds only (CODE_SIGN_ENTITLEMENTS[sdk=macosx*]); the iPad build has no entitlements file. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Vault folders picked in the open panel (read and write). -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Bookmarks of those folders, kept across launches (recent vaults). -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Printing the recovery kit (the sandbox refuses to print without it). -->
	<key>com.apple.security.print</key>
	<true/>
	<!-- Recording audio into notes (the sandbox blocks the microphone without it). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- WebDAV vaults: connections to the server the user configures (docs/io.md, "WebDAV vaults in the app"). -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
