# Template for ~/.config/sempere/release.env, read by scripts/testflight.sh (docs/releasing.md).
# Copy it OUTSIDE the repository and fill it in; never commit the filled-in file:
#
#   mkdir -p ~/.config/sempere && cp scripts/release.env.example ~/.config/sempere/release.env
#   chmod 600 ~/.config/sempere/release.env
#
# Shell syntax (KEY=value, quote values with spaces). Another location: SEMPERE_RELEASE_ENV=/path.
# A variable already set in the environment wins over this file.

# Apple Developer team ID: developer.apple.com > Account > Membership details (10 characters).
SEMPERE_TEAM_ID=TODO_TEAM_ID

# api:   App Store Connect API key plus manual App Store profiles (the block below); every upload so far.
# xcode: automatic signing with the Apple ID signed in to Xcode (Settings > Accounts); no API key. Run the
#        signing rehearsal first (docs/releasing.md "Check the setup"): just testflight both main --export-only
SEMPERE_SIGNING=api

# --- api mode ------------------------------------------------------------------------------------------
# App Store Connect > Users and Access > Integrations > App Store Connect API. Keep the .p8 file in
# ~/.config/sempere (chmod 600); Apple lets you download it only once.
SEMPERE_ASC_KEY_PATH=~/.config/sempere/AuthKey_TODO.p8
SEMPERE_ASC_KEY_ID=TODO_KEY_ID
SEMPERE_ASC_ISSUER_ID=TODO-ISSUER-UUID
# Profile and certificate names, if yours differ from these defaults:
#SEMPERE_PROFILE_IOS="Sempere iOS App Store"
#SEMPERE_PROFILE_WIDGETS_IOS="Sempere Widgets iOS App Store"
#SEMPERE_PROFILE_MAC="Sempere Mac App Store"
#SEMPERE_DIST_CERT="Apple Distribution"
#SEMPERE_INSTALLER_CERT="3rd Party Mac Developer Installer"

# --- optional ----------------------------------------------------------------------------------------
# A separate keychain holding the signing identities, unlocked before the build:
#SEMPERE_KEYCHAIN=~/Library/Keychains/sempere-signing.keychain-db
#SEMPERE_KEYCHAIN_PASSWORD_FILE=~/.config/sempere/signing-keychain.pw
# Where archives, logs and exports go (default $TMPDIR/sempere-testflight):
#SEMPERE_TF_OUT=~/Library/Developer/Sempere/testflight
