    "focaccia-memo": {
      "file": "audio/focaccia-memo.m4a",
      "sha256": "0ad5154c5b4b7f4467fe2f057ff5f4c884ac9b5458f13174b152ae3909072638",
      "voice": "af_heart",
      "title": "Voice memo: next time",
      "started": "2026-10-05T19:42:10-04:00",
      "script": "Okay, focaccia notes while I remember. Today's loaf came out a little pale, so next time I'm baking it four minutes longer. The dough felt great after the fridge rest, really bubbly. Oh, and use way more olive oil in the pan, more than you think you need. Tomatoes cut side up. And buy rosemary. We're out of rosemary."
    },
    "kepler-recap": {
      "file": "audio/kepler-recap.m4a",
      "sha256": "c0be60a96a7fce559229342c525db2f4d2faf9169e545d7ae9df1bc9c6637e9b",
      "voice": "am_michael",
      "title": "Lecture recap",
      "started": "2026-10-21T16:20:35-04:00",
      "script": "Quick recap of today's lecture. Kepler's third law: the period squared equals the semi-major axis cubed, in years and A U. So for Mars, one point five two cubed is about three point five, and the square root is one point eight eight years. I should check Saturn tomorrow, it should come out around twenty nine and a half. And remember, equal areas means the planet moves fastest at perihelion."
    }
  },
