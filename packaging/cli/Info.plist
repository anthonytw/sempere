<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The macOS CLI's bundle (docs/design/1.4-cloudkit.md §6.5): CloudKit is a restricted entitlement and macOS honors it only
     for a program inside a bundle that carries a provisioning profile, so `sempere` ships as sempere.app/Contents/MacOS/sempere
     (no UI: LSUIElement) and Homebrew links bin/sempere to it. @VERSION@ is the release's X.Y.Z (scripts/cli-bundle.sh). -->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>io.github.anthonytw.sempere.cli</string>
	<key>CFBundleExecutable</key>
	<string>sempere</string>
	<key>CFBundleName</key>
	<string>sempere</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
</dict>
</plist>
