        { "id": "r3a", "parent": "2a", "author": "A", "list": ["A", "B", "C", "R"], "removes": ["Y"], "reason": "reapply" },
        { "id": "r3b", "parent": "2a", "author": "C", "list": ["A", "B", "C", "R"], "removes": ["Y"], "reason": "reapply" }
      ],
      "context": { "me": "B", "rejected": [], "approverChains": {}, "recovery": ["R"] },
      "expect": { "kept": ["e1", "2a", "r3a"], "losses": [["2b", "2a", "rule3"], ["r3b", "r3a", "rule4"]], "reapply": [], "question": null, "contradictions": [] }
