{
  "description": "key-hierarchy design §5.6 fork resolution as trees (KH1): each case is a tree of verified epochs (ids, authors, lists and computed removals as labels; a label stands for its UTF-8 bytes, so epochId order is byte order), what the device brings (me, its stored answers, addedBy chains, recovery keys), and the expected kept chain, losses (child, winner, rule), re-application set, open question and contradictions. Scenarios from design §11.1.",
  "cases": [
    {
      "name": "honest concurrent removals: rule 4 and re-application",
      "nodes": [
        { "id": "e1", "author": "A", "list": ["A", "B", "C", "X", "Y", "R"], "removes": [], "reason": "create" },
        { "id": "2a", "parent": "e1", "author": "A", "list": ["A", "B", "C", "Y", "R"], "removes": ["X"], "reason": "remove" },
        { "id": "2b", "parent": "e1", "author": "B", "list": ["A", "B", "C", "X", "R"], "removes": ["Y"], "reason": "remove" }
      ],
      "context": { "me": "C", "rejected": [], "approverChains": {}, "recovery": ["R"] },
      "expect": { "kept": ["e1", "2a"], "losses": [["2b", "2a", "rule4"]], "reapply": ["Y"], "question": null, "contradictions": [] }
    },
    {
      "name": "two re-appliers at once: the second finds nothing left to remove",
