# The trust anchors (docs/design/1.2-audit-followups.md F-13). With "Require review from Code Owners" and "Dismiss stale
# pull request approvals when new commits are pushed" on in the repository ruleset, a PR that touches one of these paths
# needs the maintainer's approval, and a push after that approval dismisses it, so an agent seat cannot change who is
# trusted to sign releases, the release tooling, the dependency pins, the security policy or the CI itself without it.
# scripts/check-security.sh ("owners") fails when a script the release build copies or sources has no line here.
# Every line names the same owner.

# Who may sign releases, and where its fingerprint is published.
/packaging/                      @anthonytw
/SECURITY.md                    @anthonytw

# The release scripts (build, sign, publish, verify, tag, checks), their tests, and the checks that guard the tree.
/scripts/release-*              @anthonytw
/scripts/release.env.example    @anthonytw
/scripts/static-sdk-pin.sh      @anthonytw
/scripts/update-formula.sh      @anthonytw
/scripts/ci-hash.py             @anthonytw
/scripts/ci-targets.json        @anthonytw
/scripts/test-release-*.sh      @anthonytw
/scripts/check-security.sh      @anthonytw
/scripts/security-allow.txt     @anthonytw
/scripts/test-check-security.sh @anthonytw
/scripts/check-tests-run.py     @anthonytw
/scripts/ci-gate-decision.py    @anthonytw
/scripts/apt-install.sh         @anthonytw
/scripts/test-apt-install.sh    @anthonytw

# The scripts the release build copies into the tag's worktree and runs (release-build.sh TOOLING), what they source, the
# release sweep's forge helper, the release notes, the local gate and the entry points the maintainer runs.
/scripts/ci-linux.sh            @anthonytw
/scripts/build-linux-static.sh  @anthonytw
/scripts/static-sdk-cache.sh    @anthonytw
/scripts/package-cli.sh         @anthonytw
